{
  "name": "@a11ign/toolchain",
  "version": "0.1.0",
  "description": "The one test and build toolchain every a11ign repository shares: the rstest config (node:test shim, run record, verdict line), the Rslib presets, and the TypeScript base.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    "./rstest-config": {
      "types": "./dist/rstest-config.d.mts",
      "default": "./dist/rstest-config.mjs"
    },
    "./verdict-reporter": {
      "types": "./dist/verdict-reporter.d.mts",
      "default": "./dist/verdict-reporter.mjs"
    },
    "./node-test-shim": {
      "types": "./dist/node-test-shim.d.mts",
      "default": "./dist/node-test-shim.mjs"
    },
    "./register-node-test-alias": {
      "types": "./dist/register-node-test-alias.d.mts",
      "default": "./dist/register-node-test-alias.mjs"
    },
    "./merge-child-coverage": {
      "types": "./dist/merge-child-coverage.d.mts",
      "default": "./dist/merge-child-coverage.mjs"
    },
    "./entries": {
      "types": "./dist/entries.d.ts",
      "default": "./dist/entries.mjs"
    },
    "./rslib-presets": {
      "types": "./dist/rslib-presets.d.ts",
      "default": "./dist/rslib-presets.mjs"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3"
  },
  "peerDependenciesMeta": {
    "@rslib/core": {
      "optional": true
    },
    "@rstest/coverage-v8": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/a11ign.git",
    "directory": "packages/toolchain"
  },
  "homepage": "https://github.com/a11ign/a11ign",
  "keywords": [
    "rstest",
    "rslib",
    "tsconfig",
    "node:test",
    "toolchain"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build"
  }
}
