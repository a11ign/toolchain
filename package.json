{
  "name": "@a11ign/toolchain",
  "version": "0.7.0",
  "description": "The one test and build toolchain every a11ign repository shares: the rstest config (node:test shim, run record, verdict line), the Rslib presets, and the TypeScript base.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "exports": {
    "./rstest-config": {
      "types": "./dist/rstest-config.d.ts",
      "default": "./dist/rstest-config.mjs"
    },
    "./verdict-reporter": {
      "types": "./dist/verdict-reporter.d.ts",
      "default": "./dist/verdict-reporter.mjs"
    },
    "./node-test-shim": {
      "types": "./dist/node-test-shim.d.ts",
      "default": "./dist/node-test-shim.mjs"
    },
    "./register-node-test-alias": {
      "types": "./dist/register-node-test-alias.d.ts",
      "default": "./dist/register-node-test-alias.mjs"
    },
    "./merge-child-coverage": {
      "types": "./dist/merge-child-coverage.d.ts",
      "default": "./dist/merge-child-coverage.mjs"
    },
    "./entries": {
      "types": "./dist/entries.d.ts",
      "default": "./dist/entries.mjs"
    },
    "./rslib-presets": {
      "types": "./dist/rslib-presets.d.ts",
      "default": "./dist/rslib-presets.mjs"
    },
    "./mjs-ratchet": {
      "types": "./dist/mjs-ratchet.d.ts",
      "default": "./dist/mjs-ratchet.mjs"
    },
    "./layout-check": {
      "types": "./dist/layout-check.d.ts",
      "default": "./dist/layout-check.mjs"
    },
    "./boundary-check": {
      "types": "./dist/boundary-check.d.ts",
      "default": "./dist/boundary-check.mjs"
    },
    "./js-to-ts": {
      "types": "./dist/js-to-ts.d.ts",
      "default": "./dist/js-to-ts.mjs"
    },
    "./lib/changed-files": {
      "types": "./dist/lib/changed-files.d.ts",
      "default": "./dist/lib/changed-files.mjs"
    },
    "./lib/changed-packages": {
      "types": "./dist/lib/changed-packages.d.ts",
      "default": "./dist/lib/changed-packages.mjs"
    },
    "./lib/ci-changed": {
      "types": "./dist/lib/ci-changed.d.ts",
      "default": "./dist/lib/ci-changed.mjs"
    },
    "./lib/cli-flags": {
      "types": "./dist/lib/cli-flags.d.ts",
      "default": "./dist/lib/cli-flags.mjs"
    },
    "./lib/fixture-symbols": {
      "types": "./dist/lib/fixture-symbols.d.ts",
      "default": "./dist/lib/fixture-symbols.mjs"
    },
    "./lib/git-env": {
      "types": "./dist/lib/git-env.d.ts",
      "default": "./dist/lib/git-env.mjs"
    },
    "./lib/git-sandbox": {
      "types": "./dist/lib/git-sandbox.d.ts",
      "default": "./dist/lib/git-sandbox.mjs"
    },
    "./lib/isolation-gate": {
      "types": "./dist/lib/isolation-gate.d.ts",
      "default": "./dist/lib/isolation-gate.mjs"
    },
    "./lib/local-import-closure": {
      "types": "./dist/lib/local-import-closure.d.ts",
      "default": "./dist/lib/local-import-closure.mjs"
    },
    "./lib/npm-cli-executable": {
      "types": "./dist/lib/npm-cli-executable.d.ts",
      "default": "./dist/lib/npm-cli-executable.mjs"
    },
    "./lib/product-home": {
      "types": "./dist/lib/product-home.d.ts",
      "default": "./dist/lib/product-home.mjs"
    },
    "./lib/sandbox-exhaustion": {
      "types": "./dist/lib/sandbox-exhaustion.d.ts",
      "default": "./dist/lib/sandbox-exhaustion.mjs"
    },
    "./lib/source-text": {
      "types": "./dist/lib/source-text.d.ts",
      "default": "./dist/lib/source-text.mjs"
    },
    "./lib/test-memory-cap": {
      "types": "./dist/lib/test-memory-cap.d.ts",
      "default": "./dist/lib/test-memory-cap.mjs"
    },
    "./lib/tree-wide-guard": {
      "types": "./dist/lib/tree-wide-guard.d.ts",
      "default": "./dist/lib/tree-wide-guard.mjs"
    },
    "./lib/walk-scope": {
      "types": "./dist/lib/walk-scope.d.ts",
      "default": "./dist/lib/walk-scope.mjs"
    },
    "./lib/walk-scope-declaration": {
      "types": "./dist/lib/walk-scope-declaration.d.ts",
      "default": "./dist/lib/walk-scope-declaration.mjs"
    },
    "./lib/walk-scope-discovery": {
      "types": "./dist/lib/walk-scope-discovery.d.ts",
      "default": "./dist/lib/walk-scope-discovery.mjs"
    },
    "./lib/worktree-resolution": {
      "types": "./dist/lib/worktree-resolution.d.ts",
      "default": "./dist/lib/worktree-resolution.mjs"
    },
    "./tsconfig.base.json": "./tsconfig.base.json"
  },
  "bin": {
    "layout-check": "./dist/layout-check.mjs",
    "boundary-check": "./dist/boundary-check.mjs",
    "js-to-ts": "./dist/js-to-ts.mjs"
  },
  "files": [
    "dist",
    "tsconfig.base.json",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=22.15.0"
  },
  "peerDependencies": {
    "@rslib/core": "^1.0.3",
    "@rstest/core": "^0.12.3",
    "@rstest/coverage-v8": "^0.12.3",
    "typescript": "^6.0.3 || ^7.0.0"
  },
  "peerDependenciesMeta": {
    "@rslib/core": {
      "optional": true
    },
    "@rstest/coverage-v8": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a11ign/toolchain.git"
  },
  "homepage": "https://github.com/a11ign/toolchain",
  "keywords": [
    "rstest",
    "rslib",
    "tsconfig",
    "node:test",
    "toolchain"
  ],
  "scripts": {
    "build": "rslib build",
    "prepack": "rslib build",
    "lint": "eslint .",
    "pretypecheck": "pnpm run build",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm run build",
    "test": "rstest run",
    "mjs-ratchet:lower": "tsx -e \"import { writeLoweredBaseline } from './src/mjs-ratchet.ts'; console.log(writeLoweredBaseline({ from: process.cwd() }));\"",
    "consumer-check": "pnpm run build && tsx scripts/clean-consumer.ts",
    "pack-check": "tsx scripts/release-pack-contents.ts"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "^10.0.1",
    "@rslib/core": "1.0.3",
    "@rstest/core": "0.12.3",
    "@rstest/coverage-v8": "0.12.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "yaml": "2.9.1"
  }
}
