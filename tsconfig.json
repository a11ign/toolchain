{
  // The CHECKER (ADR 0043, Decision 2): `tsc --noEmit` over every `.ts` here, tests and scripts included. Nothing is built by it. Rslib builds
  // the package, and its declarations come from `tsconfig.build.json`, which leaves the tests out.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "rewriteRelativeImportExtensions": true
  },
  "include": ["src/**/*.ts", "rslib.config.ts", "scripts/**/*.ts", "rstest.config.ts"]
}
